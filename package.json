{
	"name": "watchtower",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"postinstall": "prisma generate",
		"dev": "next dev",
		"dev:test": "dotenv -e .env.test -- next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"test": "dotenv -e .env.test -- vitest run",
		"test:ci": "start-server-and-test \"dotenv -e .env.test -- next dev\" http://localhost:3000/api/health \"dotenv -e .env.test -- vitest run\"",
		"test:watch": "dotenv -e .env.test -- vitest",
		"db:migrate": "prisma migrate dev",
		"db:seed": "prisma db seed",
		"db:reset": "prisma migrate reset",
		"ingest": "tsx src/jobs/ingest.ts",
		"ingest:project": "tsx src/jobs/ingest.ts",
		"cluster": "tsx src/jobs/cluster.ts",
		"cluster:project": "tsx src/jobs/cluster.ts",
		"recompute-priority": "tsx src/jobs/recompute-priority.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"cheerio": "^1.2.0",
		"dotenv": "^17.4.2",
		"gsap": "^3.15.0",
		"iron-session": "^8.0.4",
		"motion": "^12.42.2",
		"next": "16.2.10",
		"ogl": "^1.0.11",
		"openai": "^6.47.0",
		"pg": "^8.22.0",
		"prisma": "^7.8.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"recharts": "^3.9.2",
		"rss-parser": "^3.13.0",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^20",
		"@types/pg": "^8.20.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/uuid": "^10.0.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9",
		"eslint-config-next": "16.2.10",
		"jsdom": "^29.1.1",
		"jsrepo": "^3.8.1",
		"puppeteer": "^25.3.0",
		"start-server-and-test": "^3.0.11",
		"tsx": "^4.23.1",
		"typescript": "^5",
		"vitest": "^4.1.10"
	}
}
